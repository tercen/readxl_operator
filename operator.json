{
  "name": "Excel",
  "description": "Imports file from Excel 2007-365 (.xlsx, .xlsm).",
  "tags": [
    "import"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/readxl_operator"
  ],
  "properties": [
    {
      "kind": "DoubleProperty",
      "name": "sheet",
      "defaultValue": 1,
      "description": "Sheet to read (position / index of the sheet). Default is 1."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "documentId",
            "type": "",
            "description": "The document identifier",
            "ontologyMapping": "documentId",
            "crosstabMapping": "row",
            "cardinality": "1",
            "factors": []
          }
        ],
        "axis": []
      }
    ]
  }
}